{
  "camera": {
    "cx": 319.5,
    "cy": 239.5,
    "fx": 525.0,
    "fy": 525.0
  },
  "depth": {
    "depth_anything_encoder": "vitl",
    "depth_model": "midas",
    "device": "cpu",
    "input_size": 518,
    "midas_variant": "MiDaS_small",
    "output_mode": "raw",
    "postprocess": {
      "bilateral_diameter": 7,
      "bilateral_filter": true,
      "bilateral_sigma_color": 0.1,
      "bilateral_sigma_space": 7.0,
      "enabled": false,
      "guided_eps": 0.001,
      "guided_radius": 8,
      "guided_refine": true,
      "temporal_alpha": 0.7,
      "temporal_fusion": false
    },
    "prefer_torch_hub": true,
    "source_mode": "input",
    "weights_dir": "models"
  },
  "evaluation": {
    "calibration_perturbation": {
      "cx_offset_px": 0.0,
      "cy_offset_px": 0.0,
      "enabled": false,
      "fx_scale": 1.0,
      "fy_scale": 1.0
    },
    "pose_perturbation": {
      "dropout_probability": 0.0,
      "enabled": false,
      "latency_frames": 0,
      "rotation_std_deg": 0.0,
      "seed": 0,
      "translation_std_m": 0.0
    }
  },
  "input": {
    "fps": 30,
    "height": 480,
    "mode": "rgbd_dataset",
    "source": "rgbd_dataset_freiburg1_xyz",
    "timeout_sec": 5.0,
    "width": 640
  },
  "mapping": {
    "confidence_fusion": {
      "edge_scale": 0.15,
      "enabled": false,
      "min_confidence": 0.2
    },
    "enabled": true,
    "export_path": "data/outputs/frame_cloud.ply",
    "max_points": 150000,
    "max_samples_per_frame": 2000,
    "max_voxels": 20000,
    "multi_view_consistency": {
      "enabled": false,
      "relative_error_scale": 0.1
    },
    "representation": "pointcloud",
    "semantic_color_fusion": true,
    "stride": 4,
    "tsdf_depth_scale": 1.0,
    "tsdf_depth_trunc": 4.0,
    "tsdf_estimate_normals": false,
    "tsdf_sdf_trunc": 0.08,
    "tsdf_voxel_length": 0.04,
    "voxel_size": 0.03
  },
  "output": {
    "demo_map_bounds": null,
    "demo_map_projection": "auto",
    "demo_video_fps": 15,
    "demo_video_height": 720,
    "demo_video_path": "data/outputs/atlas_demo.mp4",
    "demo_video_width": 1280,
    "output_dir": "data/outputs/benchmarks/tum_fr1_xyz_rgbd_vo",
    "save_demo_video": false,
    "save_depth_snapshot": false,
    "save_depth_video": false,
    "save_pointcloud": true,
    "save_rgb_snapshot": false,
    "save_semantic_snapshot": false,
    "save_trajectory": true,
    "visualize": false
  },
  "ros2": {
    "camera_frame_id": "atlas_camera",
    "depth_topic": "/atlas/depth",
    "enabled": false,
    "map_frame_id": "map",
    "path_topic": "/atlas/path",
    "pointcloud_topic": "/atlas/pointcloud",
    "pose_topic": "/atlas/pose",
    "visual_pose_topic": "/atlas/visual_pose"
  },
  "semantics": {
    "backend": "yolov8_seg",
    "confidence": 0.25,
    "device": "cpu",
    "enabled": false,
    "iou": 0.7,
    "model": "models/checkpoints/yolov8n-seg.pt"
  },
  "slam": {
    "frame_stride": 1,
    "match_ratio": 0.75,
    "max_depth_m": 8.0,
    "max_features": 1200,
    "min_correspondences": 20,
    "min_inliers": 12,
    "mode": "rgbd_vo",
    "pose_graph": {
      "enabled": true,
      "loop_closure": {
        "distance_threshold": 0.15,
        "enabled": false,
        "max_candidates": 3,
        "max_reprojection_error": 2.5,
        "min_inliers": 15,
        "min_matches": 30,
        "min_node_gap": 15,
        "proximity_enabled": false
      }
    },
    "pose_message_type": "pose_with_covariance",
    "pose_topic": "/rtabmap/localization_pose",
    "timeout_sec": 0.05
  },
  "visual_localization": {
    "dictionary": "DICT_4X4_50",
    "enabled": false,
    "landmarks": [],
    "marker_length_m": 0.16,
    "max_reprojection_error": 3.0,
    "pose_correction": {
      "apply_to_mapping": false,
      "blend_weight": 1.0,
      "max_rotation_innovation_deg": 45.0,
      "max_rotation_std_deg": 20.0,
      "max_timestamp_delta_sec": 0.05,
      "max_translation_innovation_m": 2.0,
      "max_translation_std_m": 0.5
    }
  }
}
